MONGO_USER=catalog
MONGO_PASSWORD=catalog
MONGO_DB=catalog_amcg
MONGO_PORT=27017
MONGO_URI=mongodb://catalog:catalog@mongo:27017/catalog_amcg?authSource=admin

PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=80

JWT_SECRET=change-me-in-production

VITE_API_URL=/api

# E-mail (código de verificação do pré-cadastro). Sem SMTP_HOST o código
# aparece só no log do backend: docker compose -f docker-compose.dev.yml logs backend
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Catálogo dos Campos Gerais <nao-responda@exemplo.com>"
